{
  "data_root": "public/Data/",
  "logging": { "enabled": true, "destination": "run_dir", "filename": "stdout.log" },
  "dataset": { "name": "NTU-Fi-HumanID" },
  "model": { "name": "Mamba" },
  "dataloader": { "batch_train": 64, "batch_test": 64, "num_workers": 0 },
  "training": {
    "epochs": 30,
    "lr": 0.001,
    "eval_only": false,
    "early_stop": {
      "enabled": true,
      "patience": 6,
      "metric": "loss",
      "min_delta": 0.0001,
      "restore_best": true
    }
  },
  "ablations": {
    "seq_len": 500,
    "pooling": "mean",
    "mamba_selective": "on",
    "shuffle_subcarriers": false,
    "shuffle_antennas": false,
    "train_fraction": 1.0,
    "noise": "none",
    "noise_p": 0.0,
    "val_noise": "none",
    "val_noise_p": null
  },
  "efficiency": { "enabled": false, "warmup": 30, "iters": 200 },
  "model_params": {
    "mamba": {
      "d_model": 256,
      "depth": 4,
      "d_state": 64,
      "d_conv": 4,
      "expand": 2,
      "dropout": 0.1
    }
  }
}
